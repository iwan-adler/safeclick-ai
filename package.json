{
  "name": "safeclick-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "screenshots": "playwright test --project=shots-desktop --project=shots-mobile",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "eval": "vitest run --config vitest.eval.config.mts",
    "eval:baseline": "vitest run --config vitest.eval.config.mts baseline",
    "eval:dev": "vitest run --config vitest.eval.config.mts dev.eval",
    "train": "vitest run --config vitest.eval.config.mts train.eval"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
